# Bootstrap keys (the only ones a real .env should hold). Everything else can
# live in the system_config collection (dynamic config) or in .env.local for dev.
ENV=development
PORT=8090
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=expenselens
JWT_SECRET=change-me-to-a-long-random-string
LOG_JSON=false

# --- Everything below resolves env → system_config → default ---

# URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:8090

# Sessions
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Storage: local | cloudinary
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/uploads
CLOUDINARY_URL=
MAX_UPLOAD_MB=20

# Extraction: gemini | fake
EXTRACTOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview
EXTRACTION_WORKERS=2

# OAuth (leave blank to disable a provider)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=

# Mail: log | smtp
MAIL_PROVIDER=log
MAIL_FROM="ExpenseLens <no-reply@expenselens.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# CORS (CSV). Defaults to APP_URL.
ALLOWED_ORIGINS=

# Shared secret for POST /openapi/config/reload (blank = route disabled)
CONFIG_RELOAD_SECRET=
