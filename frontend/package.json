{
  "name": "expenselens-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["common", "user", "admin"],
  "scripts": {
    "dev:user": "npm run dev -w user",
    "dev:admin": "npm run dev -w admin",
    "build": "npm run build -w user && npm run build -w admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write common/src user/src admin/src"
  },
  "devDependencies": {
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
