# Bootstrap keys (the only ones a real .env should hold).
ENV=development
PORT=8091
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=expenselens
JWT_SECRET=change-me-to-a-long-random-string
LOG_JSON=false

# --- Everything below resolves env → system_config → default ---
ADMIN_APP_URL=http://localhost:5174
ADMIN_ACCESS_TOKEN_TTL=30m
ADMIN_REFRESH_TOKEN_TTL=12h

# User backend: reload dynamic config after edits and retry failed
# extractions (both need CONFIG_RELOAD_SECRET set on both services).
USER_API_URL=http://localhost:8090
CONFIG_RELOAD_SECRET=

# User SPA origin, used in admin-issued password reset links
APP_URL=http://localhost:5173

# Must match the user backend so deleting an account also removes its files.
# LOCAL_STORAGE_DIR is relative to this service's cwd; use an absolute path.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=../user/.data/uploads
CLOUDINARY_URL=

# Mail (emailed password-reset links; same keys as the user backend): log | smtp
MAIL_PROVIDER=log
MAIL_FROM="ExpenseLens <no-reply@expenselens.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# CORS (CSV). Defaults to ADMIN_APP_URL.
ALLOWED_ORIGINS=
